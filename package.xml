<?xml version="1.0"?>
<package format="3">
  <name>Calculator</name>
  <version>1.0.0</version>
  <description>Python calculator with ROS topics, services, launch files and tests.</description>
  <maintainer email="212140325+xyb2000@users.noreply.github.com">xyb2000</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
